# Copiez ce fichier en ".env" et remplissez-le. Le vrai .env ne va JAMAIS sur GitHub.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=sb_secret_xxxx

# Mot de passe du gérant (bonus sécurité) : à envoyer dans l'en-tête x-admin-key
ADMIN_KEY=changez-moi

# Adresse du front autorisée par CORS (en local, Vite tourne sur le port 5173)
FRONT_URL=http://localhost:5173

PORT=3000
